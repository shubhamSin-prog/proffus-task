{% comment %}
  Shoppable lookup banner with an interaction-triggered product popup.
{% endcomment %}

{% liquid
  assign selected_product = section.settings.product
  assign selected_variant = selected_product.selected_or_first_available_variant
  assign can_add_to_cart = false
  if selected_variant != blank and selected_variant.available
    assign can_add_to_cart = true
  endif

  assign add_to_cart_label = section.settings.cta_label | default: 'Add to cart'
  assign product_form_id = 'LookupBannerProductForm-' | append: section.id
  assign add_to_cart_button_id = 'LookupBannerAddToCart-' | append: section.id
  assign product_quantity = 1
  if selected_variant != blank and selected_variant.quantity_rule.min != blank
    assign product_quantity = selected_variant.quantity_rule.min
  endif

  assign popup_title = section.settings.product_title
  if popup_title == blank and selected_product != blank
    assign popup_title = selected_product.title
  endif

  assign popup_url = section.settings.cta_link
  if popup_url == blank and selected_product != blank
    assign popup_url = selected_product.url
  endif

  assign popup_price = section.settings.price_text
  if popup_price == blank and selected_variant != blank
    assign popup_price = selected_variant.price | money
  endif

  assign popup_image = section.settings.popup_image
  if popup_image == blank and selected_product != blank
    assign popup_image = selected_product.featured_image
  endif

  assign product_gallery_count = 0
  if selected_product != blank
    assign product_gallery_count = selected_product.images.size
  endif

  assign has_product_gallery = false
  if product_gallery_count > 0
    assign has_product_gallery = true
  endif

  assign banner_alt = section.settings.banner_alt
  if banner_alt == blank
    assign banner_alt = section.settings.heading | default: popup_title
  endif

  assign popup_image_alt = section.settings.popup_image_alt
  if popup_image_alt == blank
    assign popup_image_alt = popup_title
  endif

  assign marker_label = section.settings.marker_label
  if marker_label == blank
    assign marker_label = popup_title | default: 'Open popup'
  endif

  assign rating_label = section.settings.rating_text
  if rating_label == blank
    assign rating_label = section.settings.rating_stars | append: ' out of 5 stars'
  endif

  assign has_intro = false
  if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank
    assign has_intro = true
  endif
%}

<section
  id="LookupBanner-{{ section.id }}"
  class="lookup-banner"
  data-trigger-mode="{{ section.settings.trigger_mode }}"
  data-default-open="{{ section.settings.show_popup_default }}"
  style="
    --lb-bg: {{ section.settings.background_color }};
    --lb-text: {{ section.settings.text_color }};
    --lb-muted: {{ section.settings.muted_text_color }};
    --lb-accent: {{ section.settings.accent_color }};
    --lb-star: {{ section.settings.rating_color }};
    --lb-banner-bg: {{ section.settings.banner_background_color }};
    --lb-popup-bg: {{ section.settings.popup_background_color }};
    --lb-border: {{ section.settings.border_color }};
    --lb-button-bg: {{ section.settings.button_background_color }};
    --lb-button-text: {{ section.settings.button_text_color }};
    --lb-marker-bg: {{ section.settings.marker_background_color }};
    --lb-marker-text: {{ section.settings.marker_icon_color }};
    --lb-max-width: {{ section.settings.max_width }}px;
    --lb-banner-width: {{ section.settings.banner_width }}px;
    --lb-banner-height: {{ section.settings.banner_height }}px;
    --lb-banner-mobile-height: {{ section.settings.banner_mobile_height }}px;
    --lb-popup-width: {{ section.settings.popup_width }}px;
    --lb-popup-image-width: {{ section.settings.popup_image_width }}%;
    --lb-padding-top: {{ section.settings.padding_top }}px;
    --lb-padding-bottom: {{ section.settings.padding_bottom }}px;
    --lb-padding-inline: {{ section.settings.padding_inline }}px;
    --lb-mobile-padding-inline: {{ section.settings.mobile_padding_inline }}px;
    --lb-intro-gap: {{ section.settings.intro_gap }}px;
    --lb-banner-radius: {{ section.settings.banner_radius }}px;
    --lb-popup-radius: {{ section.settings.popup_radius }}px;
    --lb-product-radius: {{ section.settings.product_image_radius }}px;
    --lb-banner-aspect: {{ section.settings.banner_aspect_ratio }};
    --lb-banner-mobile-aspect: {{ section.settings.banner_mobile_aspect_ratio }};
    --lb-banner-fit: {{ section.settings.banner_image_fit }};
    --lb-banner-mobile-fit: {{ section.settings.banner_mobile_image_fit }};
    --lb-banner-position: {{ section.settings.banner_image_position }};
    --lb-banner-mobile-position: {{ section.settings.banner_mobile_image_position }};
    --lb-marker-size: {{ section.settings.marker_size }}px;
    --lb-marker-x: {{ section.settings.marker_x }}%;
    --lb-marker-y: {{ section.settings.marker_y }}%;
    --lb-popup-x: {{ section.settings.popup_x }}%;
    --lb-popup-y: {{ section.settings.popup_y }}%;
    --lb-popup-reserve: {{ section.settings.popup_bottom_space }}px;
    --lb-heading-size: {{ section.settings.heading_size }}px;
    --lb-heading-mobile-size: {{ section.settings.heading_mobile_size }}px;
    --lb-text-size: {{ section.settings.text_size }}px;
    --lb-popup-title-size: {{ section.settings.popup_title_size }}px;
    --lb-popup-body-size: {{ section.settings.popup_body_size }}px;
  "
>
  <div class="lookup-banner__inner">
    {% if has_intro %}
      <div class="lookup-banner__intro">
        {% if section.settings.eyebrow != blank %}
          <p class="lookup-banner__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="lookup-banner__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="lookup-banner__text">{{ section.settings.text }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="lookup-banner__stage" data-lookup-stage>
      <div class="lookup-banner__frame">
        <button
          type="button"
          class="lookup-banner__trigger{% if section.settings.mobile_banner_image != blank %} lookup-banner__trigger--has-mobile{% endif %}"
          aria-haspopup="dialog"
          aria-expanded="{% if section.settings.show_popup_default %}true{% else %}false{% endif %}"
          aria-controls="LookupBannerPopup-{{ section.id }}"
          aria-label="{{ marker_label | escape }}"
          data-lookup-trigger
        >
          {% if section.settings.banner_image != blank %}
            {{
              section.settings.banner_image
              | image_url: width: 2200
              | image_tag:
                widths: '375, 550, 750, 990, 1200, 1600, 2000, 2200',
                sizes: '(min-width: 990px) min(100vw, 1100px), 100vw',
                loading: 'lazy',
                class: 'lookup-banner__image lookup-banner__image--desktop',
                alt: banner_alt
            }}
          {% else %}
            {{ 'hero-apparel-2' | placeholder_svg_tag: 'lookup-banner__image lookup-banner__placeholder lookup-banner__image--desktop' }}
          {% endif %}

          {% if section.settings.mobile_banner_image != blank %}
            {{
              section.settings.mobile_banner_image
              | image_url: width: 1100
              | image_tag:
                widths: '320, 420, 550, 750, 900, 1100',
                sizes: '100vw',
                loading: 'lazy',
                class: 'lookup-banner__image lookup-banner__image--mobile',
                alt: banner_alt
            }}
          {% endif %}

          <span class="lookup-banner__wash" aria-hidden="true"></span>
          <span class="lookup-banner__marker" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
              <path d="M2.5 12s3.6-6.5 9.5-6.5 9.5 6.5 9.5 6.5-3.6 6.5-9.5 6.5S2.5 12 2.5 12Z" />
              <circle cx="12" cy="12" r="2.8" />
            </svg>
          </span>
        </button>

        <div
          id="LookupBannerPopup-{{ section.id }}"
          class="lookup-banner__popup{% if section.settings.show_popup_default %} is-open{% endif %}"
          role="dialog"
          aria-label="{{ marker_label | escape }}"
          data-lookup-popup
          {% unless section.settings.show_popup_default %}
            hidden
          {% endunless %}
        >
          <button type="button" class="lookup-banner__close" aria-label="Close popup" data-lookup-close>
            <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
              <path d="M6 6l12 12" />
              <path d="M18 6L6 18" />
            </svg>
          </button>

          <div class="lookup-banner__product">
            <div class="lookup-banner__product-media{% if has_product_gallery == false and section.settings.mobile_popup_image != blank %} lookup-banner__product-media--has-mobile{% endif %}" data-lookup-gallery>
              {% if has_product_gallery %}
                <div class="lookup-banner__gallery-track">
                  {% for product_image in selected_product.images %}
                    {% liquid
                      assign slide_alt = product_image.alt | default: popup_title
                      assign slide_loading = 'lazy'
                      if forloop.first
                        assign slide_loading = 'eager'
                      endif
                    %}
                    <div
                      class="lookup-banner__gallery-slide{% if forloop.first %} is-active{% endif %}"
                      data-lookup-slide
                      data-slide-index="{{ forloop.index0 }}"
                      aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
                    >
                      {{
                        product_image
                        | image_url: width: 1200
                        | image_tag:
                          widths: '240, 360, 480, 640, 800, 1000, 1200',
                          sizes: '(min-width: 750px) 420px, 90vw',
                          loading: slide_loading,
                          class: 'lookup-banner__product-image',
                          alt: slide_alt
                      }}
                    </div>
                  {% endfor %}
                </div>

                {% if product_gallery_count > 1 %}
                  <div class="lookup-banner__gallery-count" aria-live="polite">
                    <span data-lookup-gallery-current>1</span>
                    <span>/</span>
                    <span>{{ product_gallery_count }}</span>
                  </div>

                  <div class="lookup-banner__gallery-controls" aria-label="Product image slider controls">
                    <button type="button" class="lookup-banner__gallery-button" aria-label="Previous product image" data-lookup-gallery-prev>
                      <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                        <path d="M15 6l-6 6 6 6" />
                      </svg>
                    </button>
                    <button type="button" class="lookup-banner__gallery-button" aria-label="Next product image" data-lookup-gallery-next>
                      <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                        <path d="M9 6l6 6-6 6" />
                      </svg>
                    </button>
                  </div>

                  <div class="lookup-banner__gallery-dots" aria-label="Product images">
                    {% for product_image in selected_product.images %}
                      <button
                        type="button"
                        class="lookup-banner__gallery-dot{% if forloop.first %} is-active{% endif %}"
                        aria-label="Show product image {{ forloop.index }}"
                        aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                        data-lookup-gallery-dot
                        data-slide-index="{{ forloop.index0 }}"
                      ></button>
                    {% endfor %}
                  </div>
                {% endif %}
              {% elsif popup_image != blank %}
                {{
                  popup_image
                  | image_url: width: 1000
                  | image_tag:
                    widths: '240, 360, 480, 640, 800, 1000',
                    sizes: '(min-width: 750px) 420px, 90vw',
                    loading: 'lazy',
                    class: 'lookup-banner__product-image lookup-banner__product-image--desktop',
                    alt: popup_image_alt
                }}

                {% if section.settings.mobile_popup_image != blank %}
                  {{
                    section.settings.mobile_popup_image
                    | image_url: width: 800
                    | image_tag:
                      widths: '240, 360, 480, 640, 800',
                      sizes: '90vw',
                      loading: 'lazy',
                      class: 'lookup-banner__product-image lookup-banner__product-image--mobile',
                      alt: popup_image_alt
                  }}
                {% endif %}
              {% else %}
                {{ 'product-apparel-1' | placeholder_svg_tag: 'lookup-banner__product-image lookup-banner__product-placeholder' }}
              {% endif %}
            </div>

            <div class="lookup-banner__content">
              {% if section.settings.popup_eyebrow != blank %}
                <p class="lookup-banner__popup-eyebrow">{{ section.settings.popup_eyebrow | escape }}</p>
              {% endif %}

              {% if popup_title != blank %}
                <h3 class="lookup-banner__popup-title">{{ popup_title | escape }}</h3>
              {% endif %}

              {% if section.settings.show_rating %}
                <div class="lookup-banner__rating" aria-label="{{ rating_label | escape }}">
                  <span class="lookup-banner__stars" aria-hidden="true">
                    {% for rating_index in (1..5) %}
                      <svg
                        class="lookup-banner__star{% if rating_index <= section.settings.rating_stars %} is-filled{% endif %}"
                        viewBox="0 0 20 20"
                        focusable="false"
                      >
                        {% render 'icon', icon: 'star' %}
                      </svg>
                    {% endfor %}
                  </span>

                  {% if section.settings.rating_text != blank %}
                    <span class="lookup-banner__rating-text">{{ section.settings.rating_text | escape }}</span>
                  {% endif %}
                </div>
              {% endif %}

              {% if popup_price != blank %}
                <p class="lookup-banner__price">{{ popup_price | escape }}</p>
              {% endif %}

              {% if section.settings.description != blank %}
                <div class="lookup-banner__description">{{ section.settings.description }}</div>
              {% endif %}

              {% if selected_product != blank %}
                <product-form-component
                  id="LookupBannerProductFormComponent-{{ section.id }}"
                  class="lookup-banner__form"
                  data-section-id="{{ section.id }}"
                  data-product-id="{{ selected_product.id }}"
                  data-quantity-default="{{ product_quantity }}"
                  on:submit="/handleSubmit"
                >
                  <div
                    class="visually-hidden"
                    aria-live="assertive"
                    role="status"
                    aria-atomic="true"
                    ref="liveRegion"
                  ></div>

                  {%- form 'product', selected_product, id: product_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                    <input
                      type="hidden"
                      name="id"
                      ref="variantId"
                      value="{{ selected_variant.id }}"
                      {% unless can_add_to_cart %}
                        disabled
                      {% endunless %}
                    >
                    <input type="hidden" name="quantity" value="{{ product_quantity }}">

                    {% render 'add-to-cart-button',
                      add_to_cart_text: add_to_cart_label,
                      class: 'lookup-banner__button add-to-cart-button',
                      can_add_to_cart: can_add_to_cart,
                      show_icon: false,
                      product: selected_product,
                      id: add_to_cart_button_id
                    %}
                  {%- endform -%}

                  <div class="lookup-banner__form-error hidden" ref="addToCartTextError"></div>
                </product-form-component>
              {% elsif section.settings.cta_label != blank and popup_url != blank %}
                <a
                  class="lookup-banner__button"
                  href="{{ popup_url }}"
                  {% if section.settings.cta_open_new_tab %}
                    target="_blank" rel="noopener noreferrer"
                  {% endif %}
                >
                  {{ section.settings.cta_label | escape }}
                </a>
              {% endif %}

              {% if section.blocks.size > 0 %}
                <div class="lookup-banner__details">
                  {% for block in section.blocks %}
                    <details
                      class="lookup-banner__detail"
                      {% if block.settings.open_by_default %}
                        open
                      {% endif %}
                      {{ block.shopify_attributes }}
                    >
                      <summary class="lookup-banner__detail-summary">
                        <span>{{ block.settings.heading | escape }}</span>
                        <span class="lookup-banner__detail-icon" aria-hidden="true"></span>
                      </summary>

                      {% if block.settings.text != blank %}
                        <div class="lookup-banner__detail-text">{{ block.settings.text }}</div>
                      {% endif %}
                    </details>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #LookupBanner-{{ section.id }} {
    padding: var(--lb-padding-top) var(--lb-padding-inline) var(--lb-padding-bottom);
    color: var(--lb-text);
    background: var(--lb-bg);
    font-family: var(--font-paragraph--family);
    font-style: var(--font-paragraph--style);
    font-weight: var(--font-paragraph--weight);
  }

  #LookupBanner-{{ section.id }} * {
    box-sizing: border-box;
  }

  #LookupBanner-{{ section.id }} .lookup-banner__inner {
    width: min(100%, var(--lb-max-width));
    margin: 0 auto;
  }

  #LookupBanner-{{ section.id }} .lookup-banner__intro {
    display: grid;
    gap: 0.75rem;
    width: min(100%, 46rem);
    margin: 0 auto var(--lb-intro-gap);
    text-align: center;
  }

  #LookupBanner-{{ section.id }} .lookup-banner__eyebrow,
  #LookupBanner-{{ section.id }} .lookup-banner__popup-eyebrow,
  #LookupBanner-{{ section.id }} .lookup-banner__price {
    margin: 0;
    letter-spacing: 0;
  }

  #LookupBanner-{{ section.id }} .lookup-banner__eyebrow,
  #LookupBanner-{{ section.id }} .lookup-banner__popup-eyebrow {
    color: var(--lb-accent);
    font-family: var(--font-subheading--family);
    font-style: var(--font-subheading--style);
    font-weight: var(--font-subheading--weight);
    font-size: 0.75rem;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #LookupBanner-{{ section.id }} .lookup-banner__heading {
    margin: 0;
    color: var(--lb-text);
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: var(--lb-heading-size);
    line-height: 1.05;
    letter-spacing: 0;
    overflow-wrap: anywhere;
  }

  #LookupBanner-{{ section.id }} .lookup-banner__text {
    color: var(--lb-muted);
    font-family: var(--font-paragraph--family);
    font-style: var(--font-paragraph--style);
    font-weight: var(--font-paragraph--weight);
    font-size: var(--lb-text-size);
    line-height: 1.65;
    letter-spacing: 0;
  }

  #LookupBanner-{{ section.id }} .lookup-banner__text p,
  #LookupBanner-{{ section.id }} .lookup-banner__description p,
  #LookupBanner-{{ section.id }} .lookup-banner__detail-text p {
    margin: 0;
  }

  #LookupBanner-{{ section.id }} .lookup-banner__text p + p,
  #LookupBanner-{{ section.id }} .lookup-banner__description p + p,
  #LookupBanner-{{ section.id }} .lookup-banner__detail-text p + p {
    margin-top: 0.7em;
  }

  #LookupBanner-{{ section.id }} .lookup-banner__stage {
    width: min(100%, var(--lb-banner-width));
    margin: 0 auto;
    padding-bottom: var(--lb-popup-reserve);
  }

  #LookupBanner-{{ section.id }} .lookup-banner__frame {
    position: relative;
    isolation: isolate;
  }

  #LookupBanner-{{ section.id }} .lookup-banner__frame::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: var(--lb-banner-radius);
    background: rgb(8 8 8 / 0.24);
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms ease;
  }

  #LookupBanner-{{ section.id }}.is-popup-open .lookup-banner__frame::after {
    opacity: 1;
  }

  #LookupBanner-{{ section.id }} .lookup-banner__trigger {
    position: relative;
    display: block;
    width: 100%;
    height: var(--lb-banner-height);
    min-height: 0;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: var(--lb-banner-radius);
    color: inherit;
    background: var(--lb-banner-bg);
    box-shadow: 0 1.1rem 3rem rgb(24 31 42 / 0.12);
    cursor: pointer;
  }

  #LookupBanner-{{ section.id }} .lookup-banner__trigger:focus-visible {
    outline: 0.15rem solid var(--lb-accent);
    outline-offset: 0.25rem;
  }

  #LookupBanner-{{ section.id }} .lookup-banner__image,
  #LookupBanner-{{ section.id }} .lookup-banner__product-image {
    display: block;
    width: 100%;
    height: 100%;
  }

  #LookupBanner-{{ section.id }} .lookup-banner__image {
    object-fit: var(--lb-banner-fit);
    object-position: var(--lb-banner-position);
    transform: scale(1.01);
    transition: transform 360ms ease;
  }

  #LookupBanner-{{ section.id }} .lookup-banner__product-image {
    object-fit: cover;
  }

  #LookupBanner-{{ section.id }} .lookup-banner__trigger:hover .lookup-banner__image,
  #LookupBanner-{{ section.id }} .lookup-banner__trigger:focus-visible .lookup-banner__image,
  #LookupBanner-{{ section.id }}.is-popup-open .lookup-banner__image {
    transform: scale(1.045);
  }

  #LookupBanner-{{ section.id }} .lookup-banner__placeholder,
  #LookupBanner-{{ section.id }} .lookup-banner__product-placeholder {
    background: linear-gradient(135deg, #f6f4ef 0%, #d8ddd7 52%, #f1f4f7 100%);
  }

  #LookupBanner-{{ section.id }} .lookup-banner__image--mobile,
  #LookupBanner-{{ section.id }} .lookup-banner__product-image--mobile {
    display: none;
  }

  #LookupBanner-{{ section.id }} .lookup-banner__wash {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.08), rgb(255 255 255 / 0)),
      radial-gradient(circle at var(--lb-marker-x) var(--lb-marker-y), rgb(255 255 255 / 0.34) 0 0.1rem, transparent 9rem);
    pointer-events: none;
  }

  #LookupBanner-{{ section.id }} .lookup-banner__marker {
    position: absolute;
    left: var(--lb-marker-x);
    top: var(--lb-marker-y);
    z-index: 2;
    display: grid;
    place-items: center;
    width: var(--lb-marker-size);
    height: var(--lb-marker-size);
    border-radius: 50%;
    color: var(--lb-marker-text);
    border: 1px solid rgb(255 255 255 / 0.7);
    background: var(--lb-marker-bg);
    box-shadow:
      0 0.65rem 1.6rem rgb(18 24 32 / 0.22),
      0 0 0 0.45rem rgb(255 255 255 / 0.16);
    transform: translate(-50%, -50%);
    backdrop-filter: blur(0.45rem);
    transition:
      transform 220ms ease,
      box-shadow 220ms ease,
      background 220ms ease,
      color 220ms ease;
  }

  #LookupBanner-{{ section.id }} .lookup-banner__marker::after {
    content: "";
    position: absolute;
    inset: -0.42rem;
    border: 1px solid rgb(255 255 255 / 0.75);
    border-radius: inherit;
    opacity: 0.85;
    animation: lookup-banner-marker-pulse-{{ section.id }} 1.9s ease-out infinite;
  }

  #LookupBanner-{{ section.id }} .lookup-banner__marker svg {
    position: relative;
    z-index: 1;
    width: 56%;
    height: 56%;
  }

  #LookupBanner-{{ section.id }} .lookup-banner__marker path,
  #LookupBanner-{{ section.id }} .lookup-banner__marker circle,
  #LookupBanner-{{ section.id }} .lookup-banner__close path {
    fill: none;
    stroke: currentcolor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  #LookupBanner-{{ section.id }} .lookup-banner__trigger:hover .lookup-banner__marker,
  #LookupBanner-{{ section.id }} .lookup-banner__trigger:focus-visible .lookup-banner__marker,
  #LookupBanner-{{ section.id }}.is-popup-open .lookup-banner__marker {
    box-shadow:
      0 0.85rem 1.9rem rgb(18 24 32 / 0.28),
      0 0 0 0.5rem rgb(255 255 255 / 0.2);
    transform: translate(-50%, -50%) scale(1.06);
  }

  #LookupBanner-{{ section.id }}.is-popup-open .lookup-banner__marker {
    color: var(--lb-button-text);
    background: var(--lb-button-bg);
    transform: translate(-50%, -50%) scale(1.08);
  }

  @keyframes lookup-banner-marker-pulse-{{ section.id }} {
    0% {
      opacity: 0.75;
      transform: scale(0.92);
    }

    70%,
