{% liquid
  assign slide_count = section.blocks.size
  assign autoplay = false

  if section.settings.autoplay and slide_count > 1
    assign autoplay = true
  endif

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<div
  class="link-slider-section section section--{{ section.settings.section_width }} spacing-style disable-section-top-offset{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    {% render 'spacing-padding', settings: section.settings %}
    --link-slider-content-align: {{ section.settings.content_alignment }};
    --link-slider-text-align: {{ section.settings.text_alignment }};
    --link-slider-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  "
  data-testid="link-slider-{{ section.id }}"
>
  {% capture slides %}
    {% for block in section.blocks %}
      {% liquid
        assign fetch_priority = 'auto'
        assign loading = 'lazy'

        if forloop.first
          assign loading = 'eager'
          assign fetch_priority = 'high'
        endif

        assign heading = block.settings.heading | default: block.settings.link_label
        assign slide_link = block.settings.image_link | default: block.settings.link
      %}

      {% capture slide %}
        <a
          class="link-slider__link"
          {% if slide_link == blank %}
            role="link"
            aria-disabled="true"
          {% else %}
            href="{{ slide_link }}"
          {% endif %}
          {% if block.settings.open_in_new_tab %}
            target="_blank"
            rel="noopener noreferrer"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <span class="link-slider__media" aria-hidden="true">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 3840
                | image_tag:
                  widths: '832, 1200, 1600, 1920, 2560, 3840',
                  sizes: '100vw',
                  loading: loading,
                  fetchpriority: fetch_priority,
                  class: 'link-slider__image',
                  alt: ''
              }}
            {% else %}
              {{ 'hero-apparel-1' | placeholder_svg_tag: 'link-slider__image link-slider__placeholder' }}
            {% endif %}
          </span>
          <span class="link-slider__overlay"></span>
          <span class="link-slider__content">
            {% if block.settings.eyebrow != blank %}
              <span class="link-slider__eyebrow">{{ block.settings.eyebrow | escape }}</span>
            {% endif %}
            {% if heading != blank %}
              <span class="link-slider__heading">{{ heading | escape }}</span>
            {% endif %}
            {% if block.settings.text != blank %}
              <span class="link-slider__text">{{ block.settings.text | escape }}</span>
            {% endif %}
            {% if block.settings.link_label != blank %}
              <span class="link-slider__text-link">{{ block.settings.link_label | escape }}</span>
            {% endif %}
          </span>
        </a>
      {% endcapture %}

      {% render 'slideshow-slide',
        index: forloop.index0,
        children: slide,
        class: 'link-slider__slide',
        slide_size: section.settings.slide_height
      %}
    {% endfor %}
  {% endcapture %}

  {% if slide_count > 0 %}
    {% capture controls %}
      {% if section.settings.show_pagination and slide_count > 1 %}
        {% render 'slideshow-controls',
          style: section.settings.pagination_style,
          item_count: slide_count,
          show_arrows: false,
          controls_on_media: true,
          pagination_position: 'center',
          icon_style: 'chevron',
          shape: 'circle'
        %}
      {% endif %}
    {% endcapture %}

    {% render 'slideshow',
      class: 'link-slider',
      slides: slides,
      slide_count: slide_count,
      slide_size: section.settings.slide_height,
      slide_position: 'stretch',
      show_arrows: false,
      controls: controls,
      autoplay: autoplay,
      autoplay_speed: section.settings.autoplay_speed
    %}
  {% endif %}
</div>

{% stylesheet %}
  .link-slider-section {
    --link-slider-min-padding: clamp(1.5rem, 5vw, 4rem);
  }

  .link-slider slideshow-container {
    background: transparent;
  }

  .link-slider slideshow-controls[controls-on-media] {
    bottom: clamp(1rem, 3vw, 2rem);
    width: 100%;
    min-height: 0;
    padding-inline: var(--link-slider-min-padding);
    mix-blend-mode: normal;
    pointer-events: none;
  }

  .link-slider slideshow-controls .slideshow-controls__dots,
  .link-slider slideshow-controls .slideshow-controls__counter {
    min-height: 2.5rem;
    border: 1px solid rgb(255 255 255 / 0.24);
    background: rgb(0 0 0 / 0.3);
    box-shadow: 0 0.6rem 1.6rem rgb(0 0 0 / 0.18);
    backdrop-filter: blur(0.7rem);
    pointer-events: auto;
  }

  .link-slider slideshow-controls .slideshow-controls__dots {
    gap: 0.55rem;
    padding: 0.7rem 0.95rem;
  }

  .link-slider slideshow-controls .slideshow-controls__dots button::after {
    background-color: rgb(255 255 255 / 0.58);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.12);
  }

  .link-slider slideshow-controls .slideshow-controls__dots button[aria-selected='true']::after {
    background-color: #ffffff;
    box-shadow: 0 0 0 0.18rem rgb(255 255 255 / 0.24);
  }

  .link-slider slideshow-controls .slideshow-controls__counter {
    color: #ffffff;
    padding: 0.65rem 1rem;
  }

  .link-slider slideshow-slides {
    border-radius: var(--link-slider-radius, 0);
  }

  .link-slider__slide {
    width: 100%;
  }

  .link-slider__link {
    position: relative;
    display: grid;
    width: 100%;
    min-height: var(--slide-min-height);
    color: var(--color-background);
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
  }

  .link-slider__media,
  .link-slider__overlay {
    position: absolute;
    inset: 0;
  }

  .link-slider__media {
    z-index: -2;
    background: rgb(var(--color-foreground-rgb) / var(--opacity-5));
  }

  .link-slider__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .link-slider__placeholder {
    background: rgb(var(--color-foreground-rgb) / var(--opacity-10));
  }

  .link-slider__overlay {
    z-index: -1;
    background: rgb(0 0 0 / var(--link-slider-overlay-opacity));
  }

  .link-slider__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: var(--link-slider-content-align);
    gap: var(--gap-sm);
    width: min(100%, 62rem);
    min-height: var(--slide-min-height);
    padding: var(--link-slider-min-padding);
    text-align: var(--link-slider-text-align);
  }

  .link-slider__eyebrow {
    font-size: var(--font-size--xs);
    text-transform: uppercase;
    letter-spacing: 0;
    opacity: 0.82;
  }

  .link-slider__heading {
    max-width: 14ch;
    font-family: var(--font-heading--family);
    font-size: 2rem;
    line-height: 0.98;
  }

  .link-slider__text {
    max-width: 36rem;
    font-size: 1rem;
    line-height: 1.45;
    opacity: 0.86;
  }

  .link-slider__text-link {
    width: fit-content;
    margin-block-start: var(--margin-sm);
    padding-block-end: 0.18rem;
    border-block-end: 1px solid currentcolor;
    font-size: var(--font-size--sm);
    line-height: 1.2;
    transition: opacity var(--animation-speed) var(--animation-easing);
  }

  .link-slider__link:hover .link-slider__text-link,
  .link-slider__link:focus-visible .link-slider__text-link {
    opacity: 0.72;
  }

  .link-slider__link:focus-visible {
    outline: var(--focus-outline-width) solid currentcolor;
    outline-offset: calc(var(--focus-outline-offset) * -1);
  }

  @media screen and (min-width: 750px) {
    .link-slider__link,
    .link-slider__content {
      min-height: var(--slide-min-height-desktop);
    }

    .link-slider__content {
      padding: clamp(3rem, 7vw, 7rem);
    }

    .link-slider__heading {
      font-size: 3.75rem;
    }

    .link-slider__text {
      font-size: 1.125rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Link slider",
  "tag": "section",
  "class": "link-slider-wrapper section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "full-width",
          "label": "Full"
        },
        {
          "value": "page-width",
          "label": "Page"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "select",
      "id": "slide_height",
      "label": "Slide height",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Speed",
      "min": 3,
      "max": 7,
      "step": 1,
      "unit": "s",
      "default": 4,
      "visible_if": "{{ section.settings.autoplay }}"
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show pagination",
      "default": true
    },
    {
      "type": "select",
      "id": "pagination_style",
      "label": "Pagination style",
      "options": [
        {
          "value": "dots",
          "label": "Dots"
        },
        {
          "value": "counter",
          "label": "Counter"
        }
      ],
      "default": "dots",
      "visible_if": "{{ section.settings.show_pagination }}"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "placeholder": "Default"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide link",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "image_link",
          "label": "Image link"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Browse the collection"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Shop now"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Link slider",
      "category": "Banners",
      "blocks": {
        "slide_1": {
          "type": "slide",
          "settings": {
            "eyebrow": "New arrivals",
            "heading": "Browse our latest products",
            "text": "Fresh styles are ready to explore.",
            "link_label": "Shop all",
            "image_link": "shopify://collections/all"
          }
        },
        "slide_2": {
          "type": "slide",
          "settings": {
            "eyebrow": "Featured",
            "heading": "Explore curated picks",
            "text": "Find the pieces customers are loving right now.",
            "link_label": "View collection",
            "image_link": "shopify://collections/all"
          }
        }
      },
      "block_order": ["slide_1", "slide_2"]
    }
  ]
}
{% endschema %}
