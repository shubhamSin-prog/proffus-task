{% liquid
  assign desktop_columns = section.settings.desktop_columns | default: 3
  assign mobile_columns = section.settings.mobile_columns | default: 1
%}

<section
  class="perfect-white-shirt perfect-white-shirt-{{ section.id }}"
  style="
    --pws-bg: {{ section.settings.background_color }};
    --pws-card-bg: {{ section.settings.card_background }};
    --pws-text: {{ section.settings.text_color }};
    --pws-body: {{ section.settings.body_color }};
    --pws-max-width: {{ section.settings.max_width }}px;
    --pws-padding-top: {{ section.settings.padding_top }}px;
    --pws-padding-bottom: {{ section.settings.padding_bottom }}px;
    --pws-padding-inline: {{ section.settings.padding_inline }}px;
    --pws-mobile-padding-inline: {{ section.settings.mobile_padding_inline }}px;
    --pws-heading-size: {{ section.settings.heading_size }}px;
    --pws-heading-mobile-size: {{ section.settings.heading_mobile_size }}px;
    --pws-heading-gap: {{ section.settings.heading_bottom_spacing }}px;
    --pws-grid-gap: {{ section.settings.grid_gap }}px;
    --pws-card-padding: {{ section.settings.card_padding }}px;
    --pws-card-radius: {{ section.settings.card_radius }}px;
    --pws-image-width: {{ section.settings.image_width }}%;
    --pws-image-mobile-width: {{ section.settings.image_mobile_width }}%;
    --pws-image-height: {{ section.settings.image_height }}px;
    --pws-image-mobile-height: {{ section.settings.image_mobile_height }}px;
    --pws-image-radius: {{ section.settings.image_radius }}px;
    --pws-title-size: {{ section.settings.title_size }}px;
    --pws-body-size: {{ section.settings.body_size }}px;
    --pws-content-gap: {{ section.settings.content_gap }}px;
    --pws-desktop-columns: {{ desktop_columns }};
    --pws-mobile-columns: {{ mobile_columns }};
  "
>
  <div class="perfect-white-shirt__inner">
    {% if section.settings.heading != blank %}
      <h2 class="perfect-white-shirt__heading">
        {{ section.settings.heading | escape }}
      </h2>
    {% endif %}

    <div class="perfect-white-shirt__grid">
      {% for block in section.blocks %}
        {% liquid
          assign loading = 'lazy'
          assign fetch_priority = 'auto'
          assign image_alt = block.settings.image_alt | default: block.settings.title | escape

          if forloop.first
            assign loading = 'eager'
            assign fetch_priority = 'high'
          endif
        %}

        <article class="perfect-white-shirt__card" {{ block.shopify_attributes }}>
          <div class="perfect-white-shirt__media{% if block.settings.mobile_image != blank %} perfect-white-shirt__media--has-mobile{% endif %}">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  widths: '240, 320, 420, 520, 640, 800, 1000, 1200',
                  sizes: '(min-width: 990px) 28vw, (min-width: 750px) 40vw, 88vw',
                  loading: loading,
                  fetchpriority: fetch_priority,
                  class: 'perfect-white-shirt__image perfect-white-shirt__image--desktop',
                  alt: image_alt
              }}
            {% else %}
              {{ 'product-apparel-1' | placeholder_svg_tag: 'perfect-white-shirt__image perfect-white-shirt__placeholder perfect-white-shirt__image--desktop' }}
            {% endif %}

            {% if block.settings.mobile_image != blank %}
              {{
                block.settings.mobile_image
                | image_url: width: 900
                | image_tag:
                  widths: '240, 320, 420, 520, 640, 800, 900',
                  sizes: '88vw',
                  loading: loading,
                  fetchpriority: fetch_priority,
                  class: 'perfect-white-shirt__image perfect-white-shirt__image--mobile',
                  alt: image_alt
              }}
            {% endif %}
          </div>

          {% if block.settings.title != blank or block.settings.text != blank %}
            <div class="perfect-white-shirt__content">
              {% if block.settings.title != blank %}
                <h3 class="perfect-white-shirt__title">
                  {{ block.settings.title | escape }}
                </h3>
              {% endif %}

              {% if block.settings.text != blank %}
                <div class="perfect-white-shirt__text">
                  {{ block.settings.text }}
                </div>
              {% endif %}
            </div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .perfect-white-shirt {
    background: var(--pws-bg);
    color: var(--pws-text);
    padding: var(--pws-padding-top) var(--pws-padding-inline) var(--pws-padding-bottom);
  }

  .perfect-white-shirt__inner {
    width: min(100%, var(--pws-max-width));
    margin: 0 auto;
  }

  .perfect-white-shirt__heading {
    margin: 0 0 var(--pws-heading-gap);
    color: var(--pws-text);
    font-size: var(--pws-heading-size);
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: 0;
  }

  .perfect-white-shirt__grid {
    display: grid;
    grid-template-columns: repeat(var(--pws-desktop-columns), minmax(0, 1fr));
    gap: var(--pws-grid-gap);
  }

  .perfect-white-shirt__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--pws-content-gap);
    min-width: 0;
    margin: 0;
    padding: var(--pws-card-padding);
    background: var(--pws-card-bg);
    border-radius: var(--pws-card-radius);
    text-align: center;
  }

  .perfect-white-shirt__media {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .perfect-white-shirt__image {
    display: block;
    width: var(--pws-image-width);
    height: var(--pws-image-height);
    border-radius: var(--pws-image-radius);
    object-fit: cover;
    object-position: center;
  }

  .perfect-white-shirt__placeholder {
    background: #dddddd;
  }

  .perfect-white-shirt__image--mobile {
    display: none;
  }

  .perfect-white-shirt__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: 100%;
  }

  .perfect-white-shirt__title {
    margin: 0;
    color: var(--pws-text);
    font-size: var(--pws-title-size);
    line-height: 1.25;
    font-weight: 800;
    letter-spacing: 0;
  }

  .perfect-white-shirt__text {
    max-width: 32ch;
    margin: 0 auto;
    color: var(--pws-body);
    font-size: var(--pws-body-size);
    line-height: 1.8;
    letter-spacing: 0;
  }

  .perfect-white-shirt__text p {
    margin: 0;
  }

  .perfect-white-shirt__text p + p {
    margin-top: 0.75em;
  }

  @media screen and (max-width: 749px) {
    .perfect-white-shirt {
      padding-right: var(--pws-mobile-padding-inline);
      padding-left: var(--pws-mobile-padding-inline);
    }

    .perfect-white-shirt__heading {
      margin-bottom: calc(var(--pws-heading-gap) * 0.75);
      font-size: var(--pws-heading-mobile-size);
    }

    .perfect-white-shirt__grid {
      grid-template-columns: repeat(var(--pws-mobile-columns), minmax(0, 1fr));
    }

    .perfect-white-shirt__image {
      width: var(--pws-image-mobile-width);
      height: var(--pws-image-mobile-height);
    }

    .perfect-white-shirt__media--has-mobile .perfect-white-shirt__image--desktop {
      display: none;
    }

    .perfect-white-shirt__image--mobile {
      display: block;
    }
  }
{% endstylesheet %}

