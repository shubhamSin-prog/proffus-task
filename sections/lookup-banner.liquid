<script>
  (() => {
    const section = document.getElementById('LookupBanner-{{ section.id }}');

    if (!section || section.dataset.lookupBannerReady === 'true') {
      return;
    }

    section.dataset.lookupBannerReady = 'true';

    const stage = section.querySelector('[data-lookup-stage]');
    const trigger = section.querySelector('[data-lookup-trigger]');
    const popup = section.querySelector('[data-lookup-popup]');
    const closeButton = section.querySelector('[data-lookup-close]');
    const gallerySlides = Array.from(section.querySelectorAll('[data-lookup-slide]'));
    const galleryDots = Array.from(section.querySelectorAll('[data-lookup-gallery-dot]'));
    const galleryPrev = section.querySelector('[data-lookup-gallery-prev]');
    const galleryNext = section.querySelector('[data-lookup-gallery-next]');
    const galleryCurrent = section.querySelector('[data-lookup-gallery-current]');

    if (!stage || !trigger || !popup) {
      return;
    }

    let closeTimer;
    let activeGalleryIndex = 0;

    const isOpen = () => popup.classList.contains('is-open');

    const setGallerySlide = (index) => {
      if (!gallerySlides.length) {
        return;
      }

      activeGalleryIndex = (index + gallerySlides.length) % gallerySlides.length;

      gallerySlides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === activeGalleryIndex;
        slide.classList.toggle('is-active', isActive);
        slide.setAttribute('aria-hidden', isActive ? 'false' : 'true');
      });

      galleryDots.forEach((dot, dotIndex) => {
        const isActive = dotIndex === activeGalleryIndex;
        dot.classList.toggle('is-active', isActive);
        dot.setAttribute('aria-current', isActive ? 'true' : 'false');
      });

      if (galleryCurrent) {
        galleryCurrent.textContent = String(activeGalleryIndex + 1);
      }
    };

    const moveGallery = (direction) => {
      setGallerySlide(activeGalleryIndex + direction);
    };

    const setOpen = (open, returnFocus = false) => {
      window.clearTimeout(closeTimer);

      if (open) {
        popup.hidden = false;
        window.requestAnimationFrame(() => {
          popup.classList.add('is-open');
          section.classList.add('is-popup-open');
          trigger.setAttribute('aria-expanded', 'true');
        });

        return;
      }

      popup.classList.remove('is-open');
      section.classList.remove('is-popup-open');
      trigger.setAttribute('aria-expanded', 'false');

      closeTimer = window.setTimeout(() => {
        if (!isOpen()) {
          popup.hidden = true;
        }
      }, 240);

      if (returnFocus) {
        trigger.focus();
      }
    };

    trigger.addEventListener('click', (event) => {
      event.preventDefault();
      setOpen(!isOpen());
    });

    if (closeButton) {
      closeButton.addEventListener('click', () => setOpen(false, true));
    }

    if (galleryPrev) {
      galleryPrev.addEventListener('click', () => moveGallery(-1));
    }

    if (galleryNext) {
      galleryNext.addEventListener('click', () => moveGallery(1));
    }

    galleryDots.forEach((dot) => {
      dot.addEventListener('click', () => {
        setGallerySlide(Number(dot.dataset.slideIndex || 0));
      });
    });

    document.addEventListener('click', (event) => {
      if (!section.contains(event.target)) {
        setOpen(false);
      }
    });

    section.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setOpen(false, true);
      }

      if (!isOpen() || gallerySlides.length < 2) {
        return;
      }

      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        moveGallery(-1);
      }

      if (event.key === 'ArrowRight') {
        event.preventDefault();
        moveGallery(1);
      }
    });

    if (section.dataset.triggerMode === 'hover_click' && window.matchMedia('(hover: hover)').matches) {
      stage.addEventListener('mouseenter', () => setOpen(true));
      stage.addEventListener('mouseleave', () => setOpen(false));
      trigger.addEventListener('focus', () => setOpen(true));
    }

    if (section.dataset.defaultOpen === 'true') {
      setOpen(true);
    }

    document.addEventListener('shopify:section:select', (event) => {
      if (event.target === section) {
        setOpen(true);
      }
    });

    document.addEventListener('shopify:block:select', (event) => {
      if (section.contains(event.target)) {
        setOpen(true);
      }
    });
  })();
</script>

